{
  "manifest_version": 3,
  "name": "Codex 双语翻译",
  "version": "0.1.0",
  "description": "点击后使用本机 Codex 把网页变成原文与译文对照阅读。",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Codex 双语翻译"
  }
}
